---
# Production inventory template — copy to hosts.yml (gitignored).
#
#   cp inventories/production/hosts.yml.example inventories/production/hosts.yml
#
# Production runs MUST use scripts/prod-run.sh. See docs/production-runbook.md.
# AD migration: docs/migration-runbook.md (dc1/dc2 naming, deferred CentOS hosts).
# VM provisioning: scripts/vm/vm-create.sh -i production <fqdn>

all:
  vars:
    ansible_python_interpreter: /usr/bin/python3

  children:
    # Group name MUST be 'dc' — roles and safety asserts key off groups['dc']
    # (DC exclusion in domain_join/samba_fileserver, ddns_client DC lookup).
    dc:
      hosts:
        dc1.example.home:
          ansible_host: 203.0.113.10
          vm_name: dc1-example-home
          vm_ip: 203.0.113.10
          vm_memory_mb: 4096
          vm_disk_gb: 24
        # Phase 2 replica — uncomment when dc2 is provisioned:
        # dc2.example.home:
        #   ansible_host: 203.0.113.11
        #   vm_name: dc2-example-home
        #   vm_ip: 203.0.113.11

    hypervisors:
      hosts:
        kvm01.example.home:
          ansible_host: 203.0.113.20
          ansible_managed: false   # CentOS/RHEL — defer until Rocky slice lands

    fileservers:
      hosts:
        kif.example.home:
          ansible_host: 203.0.113.30
          ansible_managed: false   # CentOS — defer; reprovision to Ubuntu for fileserver.yml

    ddns_clients:
      hosts:
        bastion.example.home:
          ansible_host: 203.0.113.40
          vm_name: bastion-example-home
          vm_use_dhcp: true

    linux:
      children:
        dc:
        ddns_clients:
        # hypervisors/fileservers excluded while CentOS deferred (apt-only roles)

    # Tracked for migration checklists — not targeted by default playbooks
    deferred:
      hosts:
        kvm01.example.home:
        kif.example.home:
