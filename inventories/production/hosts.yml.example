---
# Production inventory template — copy to hosts.yml (gitignored).
#
#   cp inventories/production/hosts.yml.example inventories/production/hosts.yml
#
# Production runs MUST use scripts/prod-run.sh. See docs/production-runbook.md.
# VM provisioning: scripts/vm/vm-create.sh -i production <fqdn>

all:
  vars:
    ansible_python_interpreter: /usr/bin/python3

  children:
    # Group name MUST be 'dc' — roles and safety asserts key off groups['dc']
    # (DC exclusion in domain_join/samba_fileserver, ddns_client DC lookup).
    dc:
      hosts:
        dc1.example.home:
          ansible_host: 203.0.113.10
          vm_name: dc1-example-home
          vm_memory_mb: 4096
          vm_disk_gb: 24
          ethernets:
            - addresses: [203.0.113.10/24]
              dhcp6: true
              nameservers: [203.0.113.1]
              routes: [{to: default, via: 203.0.113.1}]
        dc2.example.home:
          ansible_host: 203.0.113.11
          vm_name: dc2-example-home
          ethernets:
            - addresses: [203.0.113.11/24]
              dhcp6: true
              nameservers: [203.0.113.1]
              routes: [{to: default, via: 203.0.113.1}]

    hypervisors:
      hosts:
        kvm01.example.home:
          ansible_host: 203.0.113.20
          ansible_managed: true   # Ubuntu 24.04 post-reimage
        kif.example.home:
          ansible_host: 203.0.113.30
          ansible_managed: true   # Ubuntu 24.04 post-reimage

    fileservers:
      hosts:
        kif.example.home:

    nut_servers:
      hosts:
        kif.example.home:
        kvm01.example.home:

    bastion:
      hosts:
        bastion.example.home:
          # ansible_host is the intended DHCP reservation IP.
          ansible_host: 203.0.113.40
          vm_name: bastion-example-home
          # Omitted ethernets defaults to one dual-stack DHCP NIC on vm_network.

    # Edge nginx reverse proxy — standalone proxy01 (not the bastion).
    # Site definitions live in group_vars/reverse_proxy/vars.yml.
    reverse_proxy:
      hosts:
        proxy01.example.home:
          ansible_host: 203.0.113.23
          vm_name: proxy01-example-home
          vm_memory_mb: 2048
          vm_disk_gb: 16
          ethernets:
            - network: external-default
              dhcp4: true
              dhcp6: true
            - network: vlan4
              addresses:
                - 192.168.7.23/24

    mail_relay:
      hosts:
        mail.example.home:
          ansible_host: 203.0.113.15
          vm_name: mail-example-home
          vm_memory_mb: 512
          vm_disk_gb: 8
          ethernets:
            - dhcp4: true
              dhcp6: true
              # macaddress: 52:54:00:ab:cd:ef  # optional libvirt-only pin
        mail2.example.home:
          ansible_host: 203.0.113.17
          vm_name: mail2-example-home
          vm_memory_mb: 512
          vm_disk_gb: 8
          ethernets:
            - dhcp4: true
              dhcp6: true
              # macaddress: 52:54:00:ab:cd:f0  # optional libvirt-only pin

    # Pi-hole DNS forwarders — Ubuntu 24.04; vm-create on host hypervisor (kif/kvm01).
    pihole:
      hosts:
        pihole1.example.home:
          ansible_host: 203.0.113.18
          ansible_managed: true
          vm_name: pihole-1-example
          vm_memory_mb: 1536
          vm_disk_gb: 8
          ethernets:
            - dhcp4: true
              dhcp6: true
        pihole2.example.home:
          ansible_host: 203.0.113.22
          ansible_managed: true
          vm_name: pihole-2-example
          vm_memory_mb: 1536
          vm_disk_gb: 8
          ethernets:
            - dhcp4: true
              dhcp6: true

    # Windows guests — not Ansible-managed. vm-create --perf-profile windows11 defines
    # UEFI/Secure Boot/TPM + Hyper-V enlightenments; attach install ISO manually.
    windows:
      hosts:
        win11.example.home:
          ansible_host: 203.0.113.19
          ansible_managed: false
          vm_name: win11-example
          vm_cpu_count: 6
          vm_cpu_topology: "6,1"
          vm_memory_mb: 8192
          vm_disk_gb: 128
          vm_perf_profile: windows11
          vm_os_variant: win11
          ethernets:
            - macaddress: 52:54:00:00:11:11
              network: external-default
              dhcp4: true
              dhcp6: true

    certbot:
      children:
        dc:
        mail_relay:
      hosts:
        # Reverse proxy needs a SAN cert for every proxied FQDN (DNS-01 Dreamhost).
        proxy01.example.home:

    linux:
      children:
        dc:
        bastion:
        reverse_proxy:
        mail_relay:
        hypervisors:
        fileservers:
        linux_members:
        pihole:

    linux_members:
      hosts:
        cka-sim.example.home:
          ansible_host: 203.0.113.141
          ansible_managed: true

    # Legacy or transitional hosts — not targeted by default apt playbooks.
    # Empty post-migration (pdc retired). Keep group for structural test compatibility.
    deferred:
      hosts: {}
