---
# DC host group variables — copy to vars.yml and customize.
#
#   cp inventories/production/group_vars/dc/vars.yml.example \
#      inventories/production/group_vars/dc/vars.yml
#
# Example production domain: home.2123studios.com / HOME.2123STUDIOS.COM / workgroup HOME
# (workgroup is the first DNS label of dc_domain_name, uppercased).

domain_name: home.example
dc_realm: HOME.EXAMPLE
dc_domain_name: home.example
dc_dns_forwarders:
  - 1.1.1.1
  - 8.8.8.8
# MS-SNTP signing — VLAN 1 only (IoT VLAN 2 uses DNS ACLs but not DC time sync).
dc_ntp_allow_cidr: 192.168.1.0/24
samba_dc_chrony_group: _chrony

# Estate-wide BIND query/recursion ACLs — all hosts in the dc group inherit this.
# Do not duplicate in host_vars; see docs/dns-architecture.md.
dc_trusted_networks:
  - 192.168.1.0/24    # FerryCrossing VLAN 1
  - 192.168.3.0/24    # FerryCrossing VLAN 2 (IoT)
  - 192.168.33.0/24   # Woodbine (VPN-forwarded queries)
  - 192.168.65.0/24   # Swanhollow (VPN-forwarded queries)
  # NOT 192.168.5.0/24 — VLAN 3 (restricted) stays isolated from AD DNS

samba_dc_dns_allowed_networks: "{{ dc_trusted_networks }}"

samba_dc_dnsupdater_enabled: true
samba_dc_reverse_zones:
  - 1.168.192.in-addr.arpa

docker_engine_enabled: true
# DDNS only — do not set docker_engine_data_volumes on DCs (Docker stays on root FS).
ddns_nsupdate_enabled: true
# ddns_nsupdate_manage_ufw: true
# ddns_nsupdate_ufw_allow_cidrs:
#   - 192.168.1.0/24
#   # add 192.168.3.0/24 only if IoT DHCP will POST to the DDNS API on dc1
# ddns_nsupdate_nginx_tls: false  # enable after certbot.yml; reuses DC FQDN cert on :443

# Samba interface binding — auto-detects lo + primary NIC; override if wrong:
# samba_dc_interfaces: [lo, enp1s0]

certbot_enabled: true
certbot_provider: dreamhost_dns
certbot_domains:
  - dc1.home.2123studios.com
certbot_email: sno.sno@gmail.com
certbot_staging: true   # flip false after staging dry-run succeeds
samba_dc_tls_enabled: true

# Internal mail relay (Slice 16+) — docs/mail-relay-runbook.md
mail_relay_dns_enabled: true
mail_relay_hostname: mail.home.2123studios.com
mail_relay_target_ip: 192.168.1.15   # mail.home.2123studios.com VM — adjust to live IP

# Replica join — set on the joining DC before dc-replica-join.yml (see docs/dc-runbook.md)
# samba_dc_migration_host: true
# samba_dc_migration_mode: replica
# samba_dc_target_server_name: dc1
# samba_dc_join_server: pdc.example.home   # join source — use dc1 for new replicas
# samba_dc_join_nameservers:
#   - 192.168.1.2
# For new replicas post-migration, use dc1.example.home as join server.
# AD site for dc1 — see docs/ad-sites.md
# samba_dc_join_site: FerryCrossing
#
# Offline fallback only (legacy DC unavailable):
# samba_dc_migration_mode: restore
# samba_dc_backup_archive is passed via -e at playbook runtime, not stored here

# Operator break-glass SSH (dc-converge) — pubkey is not secret; live in gitignored vars.yml
# samba_dc_operator_enabled: true
# samba_dc_operator_user: misnow1
# samba_dc_operator_uid: <same uidNumber as AD user on members>
# samba_dc_operator_gid: <same gidNumber as primary group>
# samba_dc_operator_ssh_keys:
#   - "ssh-ed25519 AAAA... you@laptop"
