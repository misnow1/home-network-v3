---
# Reverse proxy host group variables — copy to vars.yml and customize.
#
#   cp inventories/production/group_vars/reverse_proxy/vars.yml.example \
#      inventories/production/group_vars/reverse_proxy/vars.yml
#
# Edge nginx on standalone proxy01 (dual-homed: VLAN 1 public + VLAN 4 docker).
# Issue the SAN certificate first with playbooks/certbot.yml (proxy01 is in the
# certbot group; certbot_domains below must cover every FQDN).
#
# Apply order on proxy01: baseline.yml → certbot.yml → reverse-proxy.yml
# (no domain-join, no bastion.yml). See docs/reverse-proxy-runbook.md.

# --- AD domain join ----------------------------------------------------------
# proxy01 is an edge host with no AD identity and no Kerberos NFS mounts. It stays
# in the `linux` group for baseline/security-updates/host-firewall, so opt out here
# instead — otherwise domain-join.yml fails on `realm join` for this host.
# The Postfix relay client still applies (independent of AD).
domain_join_enabled: false

# --- Certbot SAN certificate (DNS-01 via Dreamhost) --------------------------
certbot_enabled: true
certbot_provider: dreamhost_dns
certbot_email: you@2123studios.com
certbot_staging: true   # flip false after a successful staging dry-run
certbot_deploy_hook_reload_samba: false
certbot_deploy_hook_reload_nginx: true
# First entry becomes the /etc/letsencrypt/live/<name> lineage.
certbot_domains:
  - auth.2123studios.com
  - bastion.2123studios.com
  - guacamole.2123studios.com
  - kif.2123studios.com
  - paperless.2123studios.com
  - plex.2123studios.com

# --- Reverse proxy -----------------------------------------------------------
reverse_proxy_enabled: true
# Docker VLAN 4 backend — kif br4 address (mirrored octet from 192.168.1.152).
reverse_proxy_authelia_url: http://192.168.7.152:9191
# All vhosts share the SAN cert lineage (matches certbot_domains[0]).
reverse_proxy_cert_name: auth.2123studios.com

# No proxy/load balancer sits in front of nginx; Internet and LAN clients reach
# proxy01 directly. Keep nginx's X-Forwarded-For trust boundary empty so clients
# cannot spoof their source address. Add CIDRs only when deploying an upstream
# proxy whose forwarded headers nginx should trust.
reverse_proxy_trusted_proxies: []

# Brute-force throttling for auth portal and forward-auth subrequests.
reverse_proxy_rate_limit_zones:
  - name: auth_portal
    rate: 10r/s
    size: 10m
  - name: proxied_apps
    rate: 30r/s
    size: 10m

reverse_proxy_sites:
  # Authelia portal — the auth service itself (no forward-auth on itself).
  - name: auth.2123studios.com
    server_names:
      - auth.2123studios.com
    locations:
      - path: /
        proxy_pass: http://192.168.7.152:9191
        rate_limit:
          zone: auth_portal
          burst: 30
      - path: "= /api/verify"
        proxy_pass: http://192.168.7.152:9191
        include_proxy_snippet: false
        rate_limit:
          zone: auth_portal
          burst: 20
      - path: /api/authz/
        proxy_pass: http://192.168.7.152:9191
        include_proxy_snippet: false
        rate_limit:
          zone: auth_portal
          burst: 40

  # Guacamole — protected by Authelia.
  - name: guacamole.2123studios.com
    server_names:
      - guacamole.2123studios.com
    locations:
      - path: "= /"
        return: "301 /guacamole/"
      - path: /guacamole
        proxy_pass: http://192.168.7.152:4080/guacamole
        auth_required: true
        websocket: true
        rate_limit:
          zone: proxied_apps
          burst: 20

  # Paperless — no Authelia: Paperless-ngx iOS app cannot follow auth redirects.
  # Relies on Paperless native login + nginx rate_limit; backend on Docker VLAN only.
  - name: paperless.2123studios.com
    server_names:
      - paperless.2123studios.com
    locations:
      - path: /
        proxy_pass: http://192.168.7.152:8000
        websocket: true
        rate_limit:
          zone: proxied_apps
          burst: 30

  # Plex — https upstream with keepalive; bespoke tuning via escape hatches.
  - name: plex.2123studios.com
    server_names:
      - plex.2123studios.com
    gzip: true
    client_max_body_size: 100M
    upstreams:
      - name: plex_backend
        servers:
          - 192.168.7.152:32400
        keepalive: 32
    extra_server_config: |
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
      proxy_set_header Sec-WebSocket-Extensions $http_sec_websocket_extensions;
      proxy_set_header Sec-WebSocket-Key $http_sec_websocket_key;
      proxy_set_header Sec-WebSocket-Version $http_sec_websocket_version;
      proxy_http_version 1.1;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection "Upgrade";
      proxy_redirect off;
      proxy_buffering off;
    locations:
      - path: /
        include_proxy_snippet: false
        proxy_pass: https://plex_backend

  # Bastion/kif landing — transmission + guacamole (both Authelia-protected).
  - name: bastion.2123studios.com
    server_names:
      - bastion.2123studios.com
      - kif.2123studios.com
    locations:
      - path: /transmission
        proxy_pass: http://192.168.7.152:9091/transmission
        auth_required: true
        rate_limit:
          zone: proxied_apps
          burst: 20
        extra_config: |
          proxy_pass_header X-Transmission-Session-Id;
      - path: /guacamole
        proxy_pass: http://192.168.7.152:4080/guacamole
        auth_required: true
        websocket: true
        rate_limit:
          zone: proxied_apps
          burst: 20
