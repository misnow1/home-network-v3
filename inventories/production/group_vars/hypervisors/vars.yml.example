---
# Hypervisor + backup client settings — copy to vars.yml and customize.

hypervisor_libvirt_enabled: true
hypervisor_netplan_enabled: true

# Must be set here (not just the hypervisor role default): include_role loads
# docker_engine's own default (false) which would otherwise shadow it and skip Docker.
docker_engine_enabled: true

hypervisor_libvirt_users:
  - ansible
  - misnow1

# Kerberos NFS from kif — run playbooks/nfs-client.yml after domain-join.yml.
nfs_client_enabled: true

# SSH for AD users with NFS homedirs (GSSAPI + AD pubkey; password for VPN without client kinit).
domain_member_sshd_enabled: true

hypervisor_libvirt_networks:
  - name: external-default
    bridge: br0
  - name: vlan3
    bridge: br3

hypervisor_netplan_vlans:
  - id: 3
    link: "{{ hypervisor_netplan_uplink }}"

# br0 uses DHCP (router reservations); br3 is bridge-only for libvirt VLAN 3.
# Interfaces are derived from hypervisor_netplan_uplink in the netplan template.
hypervisor_netplan_bridges:
  br0:
    dhcp4: true
    dhcp6: true
    nameservers:
      search:
        - "{{ vm_dns_search | default('home.2123studios.com') }}"
  br3:
    dhcp4: false

backup_restic_repository: /var/lib/restic/prod-backup
backup_restic_password_file: /root/.restic-password
backup_scope_path: /etc/ansible-managed/backup_scope.yml
backup_docker_script_path: /usr/local/bin/backup-docker.sh
backup_run_script_path: /usr/local/bin/backup-run.sh
backup_prune_enabled: true
backup_prune_keep_daily: 7
backup_prune_keep_weekly: 4
backup_prune_keep_monthly: 6

# Declare docker volumes and VM disks in host_vars/{hostname}/vars.yml.
# Scheduled backups and offsite copy: see docs/backup-runbook.md (production section).

# Hypervisor OS reboot stops all local VMs — install security updates but reboot manually.
# See docs/security-updates-runbook.md.
unattended_upgrades_auto_reboot: false

# Host performance tuning (tuned, sysctl, THP) — off by default on production.
# Enable after lab validation; see docs/hypervisor-performance.md.
# hypervisor_perf_tuning_enabled: true
# hypervisor_libvirt_data_volume_opts: defaults,noatime
# docker_engine_data_volume_opts: defaults,noatime
