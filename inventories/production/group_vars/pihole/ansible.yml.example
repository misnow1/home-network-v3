---
# Pi-hole SSH — copy to ansible.yml (gitignored alongside vars.yml).
#
#   cp inventories/production/group_vars/pihole/ansible.yml.example \
#      inventories/production/group_vars/pihole/ansible.yml
#
# Curl-installed Pi-hole on CentOS/Rocky often has root SSH only until you add an
# ansible user. Override per-host in hosts.yml if needed.

ansible_user: root
