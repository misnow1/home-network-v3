---
# Linux member defaults — copy to vars.yml and customize.
#
# Point domain_join_dns_servers at dc1 (e.g. 192.168.1.10 for home.2123studios.com).

domain_name: home.example
domain_join_dns_servers:
  - 203.0.113.10
domain_member_allow_groups:
  - Domain Users

# Relay outbound cron mail through mail.home (domain_join postfix client — not on mail VM).
mail_relay_client_enabled: true
mail_relay_hostname: mail.home.2123studios.com
mail_relay_manage_root_forward: true
