---
# Linux member defaults — copy to vars.yml and customize.
#
# Most members use DHCP/systemd-resolved for DNS — leave domain_join_manage_resolv_conf
# false (default). Set domain_join_manage_resolv_conf: true and domain_join_dns_servers
# only when AD must be reached before normal resolver config exists (e.g. new DC build).

linux_baseline_timezone: America/New_York

domain_name: home.example
# domain_join_manage_resolv_conf: false
# domain_join_dns_servers:
#   - 203.0.113.10
domain_member_allow_groups:
  - Domain Users

# Password sudo for AD groups (default in domain_join role: Domain Admins).
# domain_member_sudo_groups:
#   - Domain Admins

# Relay outbound cron mail through mail.home (domain_join postfix client — not on mail VM).
mail_relay_client_enabled: true
mail_relay_hostname: mail.home.2123studios.com
mail_relay_manage_root_forward: true
