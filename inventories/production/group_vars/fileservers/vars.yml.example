---
# File server group variables — copy to vars.yml and customize.
#
# Ubuntu file servers only.

domain_name: home.example
fileserver_dns_servers:
  - 203.0.113.10

# Legacy single-share (lab-style). When fileserver_shares is non-empty, these are ignored.
fileserver_share_name: data
fileserver_share_path: /srv/samba/data

# Multi-share example (production kif uses host_vars). Empty list => legacy single share.
