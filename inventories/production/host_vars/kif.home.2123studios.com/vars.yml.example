---
# kif NUT host variables — copy to vars.yml (gitignored alongside production inventory).
#
#   mkdir -p inventories/production/host_vars/kif.home.2123studios.com
#   cp inventories/production/host_vars/kif.home.2123studios.com/vars.yml.example \
#      inventories/production/host_vars/kif.home.2123studios.com/vars.yml
#
# Secrets live in inventories/production/group_vars/all/vault.yml — see docs/vault-schema.md.

# kif keeps hand-restored smb.conf ([homes], [archive], [media], etc.) until ROADMAP 19+.
# Restore from /archive/pre-reimage-kif-2026-06-29/samba/smb.conf if Ansible overwrote it.
fileserver_samba_enabled: false

mdadm_monitor_enabled: true

nut_ups_mode: netserver
nut_ups_listen_address: 192.168.1.152

nut_ups_usb_vendorid: "0764"
nut_ups_usb_productid: "0501"

nut_ups_devices:
  - name: kifups
    driver: usbhid-ups
    port: auto
    description: "CP1500AVRLCDa - local rack UPS"
    enabled: true
    options:
      pollinterval: 15
      pollfreq: 30
      ondelay: 0
      offdelay: 20

  - name: livingroomups
    driver: snmp-ups
    port: 192.168.1.193
    description: "Living room CyberPower SNMP card"
    enabled: false
    options:
      community: "{{ vault_nut_snmp_community_livingroom | default('public') }}"
      snmp_version: v1

nut_ups_minsupplies: 1

nut_notify_email_enabled: true
nut_notify_pushover_enabled: true

nut_notify_messages:
  onbatt:
    subject: "[UPS] kif on battery"
    body: "UPS kifups switched to battery power."
  online:
    subject: "[UPS] kif back on line power"
    body: "UPS kifups is receiving line power again."
  lowbatt:
    subject: "[UPS] kif LOW BATTERY"
    body: "UPS kifups battery is critically low; shutdown may follow."
  commbad:
    subject: "[UPS] kif communication lost"
    body: "Lost communication with a monitored UPS on kif."

# Hypervisor — host-specific uplink NIC and pools (bridges in group_vars/hypervisors).
hypervisor_netplan_uplink: ens5f0np0
hypervisor_netplan_optional_nics:
  - ens5f1np1
  - eno1
  - eno2
hypervisor_libvirt_pools_extra:
  - name: boot
    path: /var/lib/libvirt/boot
    mode: "0711"
    owner: root
    group: root

# GRUB — IOMMU passthrough (broken ASMedia RMRR + DMA PTE WARNs on X10SRi-F EOL BIOS)
# and a short menu timeout for IPMI/console recovery. Requires reboot to apply cmdline.
hypervisor_grub_manage: true
hypervisor_grub_timeout: 5
hypervisor_grub_timeout_style: menu
hypervisor_grub_cmdline_linux_extra:
  - intel_iommu=on
  - iommu=pt

# Console break-glass root password (vault_root_password). Does not enable SSH root.
linux_baseline_root_console_enabled: true

# Libvirt storage — only /var/lib/libvirt/images on a dedicated LV (kif2/libvirt-images).
hypervisor_libvirt_volume_group: kif2
hypervisor_libvirt_data_volumes:
  - { lv: libvirt-images, mount: /var/lib/libvirt/images, size: 500G }

# Docker workload storage — dedicated LVs on kif2 (see host_vars and hypervisor role).
docker_engine_volume_group: kif2
docker_engine_data_volumes:
  - { lv: docker, mount: /srv/docker, size: 50G }
  - { lv: docker-volumes, mount: /var/lib/docker/volumes, size: 200G }
