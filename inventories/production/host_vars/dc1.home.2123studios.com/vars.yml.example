---
# dc1 — LDAP VIP primary (MASTER) and cert SAN for ldap.home.2123studios.com

certbot_domains:
  - dc1.home.2123studios.com
  - ldap.home.2123studios.com

ldap_vip_state: MASTER
ldap_vip_priority: 100

# Optional SMB share served from this DC only.
samba_dc_shares:
  - name: images
    path: /export/images
    read_only: true
    guest_ok: true
