---
# dc1 — LDAP VIP primary (MASTER) and cert SAN for ldap.home.2123studios.com

certbot_domains:
  - dc1.home.2123studios.com
  - ldap.home.2123studios.com

ldap_vip_state: MASTER
ldap_vip_priority: 100

# Security updates — reboot after dc2 (BACKUP). Local time: America/New_York.
unattended_upgrades_auto_reboot: true
unattended_upgrades_reboot_time: "02:45"

# Nightly AD offline backup is orchestrated from kif (01:15), not from this host.
backup_ad_source: true

# Optional SMB share served from this DC only.
samba_dc_shares:
  - name: images
    path: /export/images
    read_only: true
    guest_ok: true
