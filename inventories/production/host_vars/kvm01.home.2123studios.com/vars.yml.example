---
# kvm01 hypervisor host variables — copy to vars.yml (gitignored alongside production inventory).
#
#   mkdir -p inventories/production/host_vars/kvm01.home.2123studios.com
#   cp inventories/production/host_vars/kvm01.home.2123studios.com/vars.yml.example \
#      inventories/production/host_vars/kvm01.home.2123studios.com/vars.yml
#
# Apply after Ubuntu 24.04 reimage: baseline.yml → hypervisor.yml → backup.yml
# Shared hypervisor settings: inventories/production/group_vars/hypervisors/vars.yml
#
# NUT monitor passwords: inventories/production/group_vars/all/vault.yml — see docs/vault-schema.md
# Converge: playbooks/nut-converge.yml — see docs/nut-runbook.md

nut_ups_mode: netserver
nut_ups_listen_address: 192.168.1.21

nut_ups_usb_vendorid: "0764"
nut_ups_usb_productid: "0501"

nut_ups_devices:
  - name: deskups
    driver: usbhid-ups
    port: auto
    description: "CP1500AVRLCDa - local rack UPS"
    enabled: true
    options:
      pollinterval: 15
      pollfreq: 30
      ondelay: 0
      offdelay: 20

hypervisor_netplan_uplink: enp5s0
hypervisor_netplan_optional_nics:
  - enp6s0
  - enp7s0f3u5
  - wlp4s0

# Pin br0 to the uplink MAC so the DHCP reservation keeps this host's IP after the
# uplink is enslaved into br0 (otherwise networkd derives a new br0 MAC -> new IP and
# the converge loses the host). Get it from `ip link show enp5s0` (link/ether).
# hypervisor_netplan_br0_macaddress: "aa:bb:cc:dd:ee:ff"

# Libvirt storage — whole /var/lib/libvirt on a dedicated LV. Do NOT reformat the
# retained cs/libvirt filesystem; size is only used if the LV is missing.
hypervisor_libvirt_volume_group: cs
hypervisor_libvirt_data_volumes:
  - { lv: libvirt, mount: /var/lib/libvirt, size: 1T }

# Docker workload storage — tune sizes against `vgs cs` free extents before first converge.
docker_engine_volume_group: cs
docker_engine_data_volumes:
  - { lv: docker, mount: /srv/docker, size: 50G }
  - { lv: docker-volumes, mount: /var/lib/docker/volumes, size: 200G }

# RTX 3050 — install driver on reimage; toolkit auto-detects the GPU.
docker_engine_nvidia_install_driver: true

# GRUB menu timeout for console recovery (no IOMMU cmdline extras on kvm01).
hypervisor_grub_manage: true
hypervisor_grub_timeout: 5
hypervisor_grub_timeout_style: menu

# Console break-glass root password (vault_root_password). Does not enable SSH root.
linux_baseline_root_console_enabled: true

# Backup scope — declare docker volumes and VM disks as needed (Slice 7).
# backup_libvirt_vms: []

# Hypervisor OS reboot stops all local VMs — install updates, reboot manually.
unattended_upgrades_auto_reboot: false
