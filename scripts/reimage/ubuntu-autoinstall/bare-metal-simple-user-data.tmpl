#cloud-config
# Generated by scripts/reimage/cloud-init-from-inventory.sh (bare_metal_simple).
# Do not edit by hand on the USB — regenerate from inventory.
autoinstall:
  version: 1
  identity:
    hostname: ${AUTOINSTALL_HOSTNAME}
    username: ansible
    realname: Ansible automation
    password: "${AUTOINSTALL_PASSWORD_HASH}"
  ssh:
    install-server: true
    allow-pw: false
    authorized-keys:
      - "${AUTOINSTALL_SSH_PUBKEY}"
  network:
${AUTOINSTALL_NETWORK_YAML}
  storage:
    layout:
      name: ${AUTOINSTALL_STORAGE_LAYOUT}
  packages:
    - openssh-server
    - python3
    - python3-apt
  late-commands:
    - curtin in-target --target=/target -- bash -c 'echo "ansible ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/ansible && chmod 440 /etc/sudoers.d/ansible'
    - curtin in-target --target=/target -- passwd -l ansible
