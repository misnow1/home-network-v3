#cloud-config
autoinstall:
  version: 1
  interactive-sections:
    - storage
  identity:
    hostname: ${AUTOINSTALL_HOSTNAME}
    username: ansible
    realname: Ansible automation
    password: "${AUTOINSTALL_PASSWORD_HASH}"
  ssh:
    install-server: true
    allow-pw: false
    authorized-keys:
      - "${AUTOINSTALL_SSH_PUBKEY}"
  packages:
    - openssh-server
    - python3
    - python3-apt
  late-commands:
    - curtin in-target --target=/target -- bash -c 'echo "ansible ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/ansible && chmod 440 /etc/sudoers.d/ansible'
    - curtin in-target --target=/target -- passwd -l ansible
${AUTOINSTALL_LATE_FSTAB}
