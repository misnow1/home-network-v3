# /data/home-ddns/home-ddns.env — root-only (mode 0600).
# Copy to home-ddns.env and set DDNS_BEARER_TOKEN before cutover.

DDNS_UPDATE_URL="http://192.168.1.10:8765/ddns/v1/lease"
DDNS_BEARER_TOKEN="CHANGE_ME"
DDNS_DNS_DOMAIN="home.2123studios.com"
# Optional fallback when a second DC runs the DDNS API:
# DDNS_UPDATE_URL_FALLBACK="http://192.168.1.11:8765/ddns/v1/lease"
# Optional debug log on gateway:
# DDNS_LOG_FILE="/data/home-ddns/hook.log"
#
# Note: DDNS_ENV_FILE is exported by dhcp-script-wrapper.sh before the hook runs.
# Do not rely on setting DDNS_ENV_FILE inside this file — it is not sourced yet.
