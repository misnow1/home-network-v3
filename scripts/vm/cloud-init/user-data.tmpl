#cloud-config
hostname: ${VM_HOST_SHORT}
fqdn: ${VM_FQDN}
manage_etc_hosts: true

users:
  - name: ansible
    gecos: Ansible automation user
    sudo: ALL=(ALL) NOPASSWD:ALL
    shell: /bin/bash
    ssh_authorized_keys:
      - ${VM_SSH_PUBKEY}
    lock_passwd: true

ssh_pwauth: false
disable_root: true

package_update: true
packages:
  - python3
  - python3-apt
  - openssh-server
  - cloud-init
  - cloud-guest-utils
  - qemu-guest-agent

write_files:
  - path: /etc/netplan/99-vm-network.yaml
    permissions: '0600'
    content: |
${VM_NETPLAN_YAML}

runcmd:
  - netplan apply
  - systemctl enable --now qemu-guest-agent
