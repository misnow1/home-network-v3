# Copy to .env on kif (/srv/docker/mail-relay/.env) — never commit .env

MAIL_RELAY_HOSTNAME=mail.home.2123studios.com
MAIL_RELAY_DOMAIN=home.2123studios.com

# Trusted internal subnets (Postfix mynetworks)
MAIL_RELAY_MYNETWORKS=127.0.0.0/8,192.168.1.0/24

# Gmail smarthost (use an app password, not your account password)
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=change-me-app-password

# Where root@*.home.2123studios.com mail is delivered
MAIL_DEFAULT_RECIPIENT=you@gmail.com
