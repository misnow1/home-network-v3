# Vault password files — never commit
.vault_pass
.vault_pass_lab
.vault-pass
.vault-pass-lab

# Lab SSH private key (public key is committed)
scripts/vm/keys/lab_id_ed25519

# Production VM SSH private key (public key is committed)
scripts/vm/keys/prod_id_ed25519

# Legacy path (removed — keys live under scripts/vm/keys/)
scripts/lab/keys/lab_id_ed25519

# Production inventory (real IPs and hostnames)
inventories/production/hosts.yml
inventories/production/host_vars/
inventories/production/group_vars/vault.yml
inventories/production/group_vars/all/vault.yml
inventories/production/group_vars/all/ansible.yml
inventories/production/group_vars/pihole/ansible.yml
inventories/production/group_vars/**/vars.yaml
inventories/production/group_vars/**/vars.yml
!inventories/production/group_vars/**/*.example

# CKA inventory (DHCP IPs are local)
inventories/cka/hosts.yml

# Lab runtime artifacts
.lab/

# Python virtual environment
.venv/

# Ansible retry files
*.retry

# Production run logs
logs/

# Migration discovery exports (local AD dumps, fleet notes)
.migration/

# Local Samba backup archives (migration restore drills)
backups/

# Python bytecode
__pycache__/
*.pyc
*.pyo

# Editor / OS noise
.DS_Store
*.swp
*.swo

.tmp*