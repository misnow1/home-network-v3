# Ansible-managed — see roles/nut_ups/templates/ups.conf.j2
{% for device in nut_ups_devices %}
{% if device.enabled | default(true) | bool %}
[{{ device.name }}]
    driver = {{ device.driver }}
    port = {{ device.port }}
{% if device.description is defined %}
    desc = "{{ device.description }}"
{% endif %}
{% for key, value in (device.options | default({})).items() %}
    {{ key }} = {{ value }}
{% endfor %}

{% endif %}
{% endfor %}
