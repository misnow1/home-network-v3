#!/usr/bin/env bash
# {{ ansible_managed }}
# Scheduled backup entrypoint — docker volumes, host paths, retention, optional copy.
set -uo pipefail

exec 9>/run/ansible-backup.lock
if ! flock -n 9; then
  echo "$(date -Iseconds) | ERROR: another ansible-backup run holds /run/ansible-backup.lock" >&2
  exit 1
fi

export RESTIC_REPOSITORY="{{ backup_restic_repository }}"
export RESTIC_PASSWORD_FILE="{{ backup_restic_password_file }}"

DOCKER_SCRIPT="{{ backup_docker_script_path }}"
PATHS_SCRIPT="{{ backup_paths_script_path }}"
OFFSITE_REPO="{{ backup_offsite_repository }}"
OFFSITE_COPY="{{ backup_offsite_copy_enabled | lower }}"
MAIL_TO="{{ backup_failure_mail_to }}"

mail_failure() {
  local subject="$1"
  local body="$2"
  if [ -z "$MAIL_TO" ]; then
    return 0
  fi
  if command -v mail >/dev/null 2>&1; then
    printf '%s\n' "$body" | mail -s "$subject" "$MAIL_TO" || true
  else
    echo "$(date -Iseconds) | WARNING: mail command missing; cannot notify ${MAIL_TO}" >&2
  fi
}

run_docker_backup() {
  if [ ! -x "$DOCKER_SCRIPT" ]; then
    echo "$(date -Iseconds) | ERROR: docker backup script missing: $DOCKER_SCRIPT" >&2
    return 1
  fi
  "$DOCKER_SCRIPT"
}

run_paths_backup() {
  if [ ! -x "$PATHS_SCRIPT" ]; then
    echo "$(date -Iseconds) | ERROR: path backup script missing: $PATHS_SCRIPT" >&2
    return 1
  fi
  "$PATHS_SCRIPT"
}

run_prune() {
{% if backup_prune_enabled %}
  restic forget \
    --keep-daily {{ backup_prune_keep_daily }} \
    --keep-weekly {{ backup_prune_keep_weekly }} \
    --keep-monthly {{ backup_prune_keep_monthly }} \
    --prune
{% else %}
  echo "$(date -Iseconds) | prune | disabled"
{% endif %}
}

run_offsite_copy() {
  if [ "$OFFSITE_COPY" != "true" ] || [ -z "$OFFSITE_REPO" ]; then
    return 0
  fi
  # Destination repository is -r; source is --from-repo.
  restic -r "$OFFSITE_REPO" --password-file "$RESTIC_PASSWORD_FILE" \
    copy --from-repo "$RESTIC_REPOSITORY" --from-password-file "$RESTIC_PASSWORD_FILE"
}

status=0
run_docker_backup || status=1
run_paths_backup || status=1

if [ "$status" -eq 0 ]; then
  run_prune || status=1
else
  echo "$(date -Iseconds) | prune | skipped because backup failed" >&2
fi

if [ "$status" -eq 0 ]; then
  run_offsite_copy || status=1
else
  echo "$(date -Iseconds) | offsite | skipped because backup failed" >&2
fi

if [ "$status" -ne 0 ]; then
  mail_failure \
    "[ansible-backup] FAILED on $(hostname -s)" \
    "ansible-backup.service failed on $(hostname -s) at $(date -Iseconds).
Check: journalctl -u {{ backup_systemd_unit }}.service -n 80
Repo: $RESTIC_REPOSITORY"
fi

exit "$status"
