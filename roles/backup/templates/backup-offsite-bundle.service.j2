# {{ ansible_managed }}
[Unit]
Description=Restic live offsite bundle (USB / removable)
Documentation=file:///usr/share/doc/home-network-v3/backup-runbook.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart={{ backup_offsite_bundle_script_path }}
Environment=HOME={{ backup_cache_home }}
Environment=RESTIC_CACHE_DIR={{ backup_cache_dir }}
Nice=10
IOSchedulingClass=best-effort
TimeoutStartSec={{ backup_offsite_bundle_timeout_sec }}

[Install]
WantedBy=multi-user.target
