{# BIND9 options for Samba AD DC with BIND9_DLZ backend. #}
options {
    directory "/var/cache/bind";

    tkey-gssapi-keytab "/var/lib/samba/bind-dns/dns.keytab";

    minimal-responses yes;

    forwarders {
{% for forwarder in dc_dns_forwarders %}
        {{ forwarder }};
{% endfor %}
    };

    forward only;

    // DNSSEC validation is disabled: AD forwarders and internal-only zones
    // make end-to-end validation impractical for the AD domain.
    dnssec-validation no;

    // Answer on loopback and the DC LAN IP. Avoid listen-on { any; } so Docker
    // bridge addresses (docker0, br-*) are not opened for DNS.
{% if samba_dc_bind_interfaces_only | bool %}
    listen-on {
        127.0.0.1;
        {{ vm_ip | default(ansible_host) }};
    };
{% else %}
    listen-on { any; };
{% endif %}
    listen-on-v6 { any; };
    allow-query {
        localhost;
{% if samba_dc_dns_include_localnets | bool %}
        localnets;
{% endif %}
{% for net in samba_dc_dns_allowed_networks %}
        {{ net }};
{% endfor %}
    };
    allow-recursion {
        localhost;
{% if samba_dc_dns_include_localnets | bool %}
        localnets;
{% endif %}
{% for net in samba_dc_dns_allowed_networks %}
        {{ net }};
{% endfor %}
    };
};
