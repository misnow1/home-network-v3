{# BIND9 options for Samba AD DC with BIND9_DLZ backend. #}
options {
    directory "/var/cache/bind";

    tkey-gssapi-keytab "/var/lib/samba/bind-dns/dns.keytab";

    minimal-responses yes;

    forwarders {
{% for forwarder in dc_dns_forwarders %}
        {{ forwarder }};
{% endfor %}
    };

    forward only;

    // DNSSEC validation is disabled: AD forwarders and internal-only zones
    // make end-to-end validation impractical for the AD domain.
    dnssec-validation no;

    // Answer on every interface so members can reach the DC by its LAN IP,
    // but only recurse/answer for trusted networks to avoid being an open
    // resolver (DNS amplification / cache-poisoning exposure).
    listen-on { any; };
    listen-on-v6 { any; };
    allow-query {
        localhost;
{% if samba_dc_dns_include_localnets | bool %}
        localnets;
{% endif %}
{% for net in samba_dc_dns_allowed_networks %}
        {{ net }};
{% endfor %}
    };
    allow-recursion {
        localhost;
{% if samba_dc_dns_include_localnets | bool %}
        localnets;
{% endif %}
{% for net in samba_dc_dns_allowed_networks %}
        {{ net }};
{% endfor %}
    };
};
