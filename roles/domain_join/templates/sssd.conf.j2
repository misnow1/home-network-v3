# {{ ansible_managed }}
# SSSD for AD domain members — realmd + sssd (no winbind).
[sssd]
domains = {{ domain_name }}
config_file_version = 2
{% if not (sssd_socket_activation | bool) %}
services = nss, pam{% if domain_member_sshd_enabled | bool and domain_member_sshd_authorized_keys_command | bool %}, ssh{% endif %}
{% endif %}

[domain/{{ domain_name }}]
id_provider = ad
auth_provider = ad
access_provider = simple
ad_domain = {{ domain_name }}
krb5_realm = {{ domain_name | upper }}

ldap_id_mapping = {{ sssd_ldap_id_mapping | string | lower }}
use_fully_qualified_names = {{ sssd_use_fully_qualified_names | ternary('True', 'False') }}

override_homedir = {{ sssd_fall_back_homedir }}
fallback_homedir = {{ sssd_fall_back_homedir }}
default_shell = /bin/bash

cache_credentials = true
krb5_store_password_if_offline = true
{% if sssd_krb5_renewable | bool %}
krb5_renewable_lifetime = {{ sssd_krb5_renewable_lifetime }}
krb5_renew_interval = {{ sssd_krb5_renew_interval }}
{% endif %}

{# NOTE: with access_provider = simple and no simple_allow_groups, SSSD's
   simple provider grants access to ALL domain users. Set
   domain_member_allow_groups (group_vars) to restrict login to named groups. #}
{% if domain_member_allow_groups | length > 0 %}
simple_allow_groups = {{ domain_member_allow_groups | join(', ') }}
{% endif %}
