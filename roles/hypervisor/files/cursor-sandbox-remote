# Cursor Remote SSH sandbox helper — allows user namespaces on Ubuntu 24.04+
# when kernel.apparmor_restrict_unprivileged_userns=1 (default).
#
# Pattern matches Ubuntu's /etc/apparmor.d/code profile for VS Code.

abi <abi/4.0>,
include <tunables/global>

profile cursor_sandbox_remote /home/*/.cursor-server/bin/*/*/resources/helpers/{cursor-sandbox,cursorsandbox} flags=(unconfined) {
  userns,

  # Site-specific additions and overrides. See local/README for details.
  include if exists <local/cursor-sandbox-remote>
}
