{
  "log-driver": "json-file",
  "log-opts": {
    "max-size": "10m",
    "max-file": "3"
  }{% if docker_engine_nvidia_toolkit_enabled | default(false) | bool %},
  "runtimes": {
    "nvidia": {
      "path": "nvidia-container-runtime",
      "runtimeArgs": []
    }
  }{% endif %}{% if docker_engine_nvidia_default_runtime | default(false) | bool %},
  "default-runtime": "nvidia"{% endif %}
}
