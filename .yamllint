---
extends: default

ignore: |
  .venv/
  .lab/
  inventories/**/vault.yml

rules:
  line-length:
    max: 160
    level: warning
  truthy:
    allowed-values: ['true', 'false', 'yes', 'no']
    level: error
  # Aligned with ansible-lint's embedded yamllint config to avoid the
  # "incompatible custom yamllint configuration" warning.
  comments:
    min-spaces-from-content: 1
  comments-indentation: false
  braces:
    max-spaces-inside: 1
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
